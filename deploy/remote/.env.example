# Copy to .env. These settings identify your deployment; never paste access tokens here.
VAULT_HOST_PATH=/absolute/path/to/your/already-synced/vault
PUID=1000
PGID=1000
TZ=America/Halifax
OBSIDIAN_PUBLIC_URL=https://your-node.your-tailnet.ts.net
OBSIDIAN_OAUTH_ISSUER=https://your-identity-provider.example/your-issuer-path
OBSIDIAN_OAUTH_AUDIENCE=https://your-node.your-tailnet.ts.net/mcp
# Stable OIDC sub claim for your account, not your display name/email unless the IdP uses it.
OBSIDIAN_OAUTH_SUBJECTS=your-subject-id
# Keep graph and daily-note tools. The upstream core profile excludes both.
OBSIDIAN_TOOLS=!open_in_obsidian

# Optional: replace your existing continuous-sync process with managed one-shot sync.
# Follow docs/chatgpt-homelab.md before enabling. Use the edge-sync image with managed mode.
OBSIDIAN_IMAGE=ghcr.io/rygwdn/obsidian-mcp:edge
# Only used by the optional compose.build.yaml override:
OBSIDIAN_IMAGE_TARGET=final
OBSIDIAN_SYNC_MODE=disabled
OBSIDIAN_SYNC_TIMEOUT_SECS=90
OBSIDIAN_SYNC_READ_TTL_MS=0
